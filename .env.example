# ==========================================
# AgriVision Environment Configuration Contract
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git!
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & CORS (Comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Neon PostgreSQL connection URL)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://agrivision_user:example_password@ep-sample-123456.us-east-2.aws.neon.tech/agrivision?sslmode=require

# Machine Learning Inference Settings
MODEL_PATH=ml/models/agrivision_mobilenetv2.onnx
CONFIDENCE_THRESHOLD=0.70
MAX_IMAGE_SIZE_MB=5

# Frontend Configuration (used by Vite)
VITE_API_URL=http://localhost:8000
